{
  "name": "buildline",
  "version": "0.3.0",
  "description": "Install an AI software factory into any project. A spec-driven pipeline for Claude Code (and any AGENTS.md-compatible agent), for developers, designers and product managers.",
  "type": "module",
  "bin": {
    "buildline": "bin/buildline.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/buildline.js"
  },
  "keywords": [
    "claude-code",
    "ai",
    "agents",
    "software-factory",
    "spec-driven",
    "agents-md",
    "cursor",
    "codex",
    "cli"
  ],
  "author": "Julian Oczkowski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianoczkowski/buildline.git"
  },
  "homepage": "https://github.com/julianoczkowski/buildline#readme",
  "bugs": "https://github.com/julianoczkowski/buildline/issues",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  }
}
